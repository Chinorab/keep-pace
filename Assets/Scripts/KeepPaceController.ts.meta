    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Cadence (sourced: AHA 2025, ERC 2025)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Cadence"}'
    - '// @input float minIntervalMs = 500 {"hint":"Shortest on-pace interval, ms (120 per minute)"}'
    - '// @input float maxIntervalMs = 600 {"hint":"Longest on-pace interval, ms (100 per minute)"}'
    - '// @input float metronomeBpm = 110 {"hint":"Metronome tempo of brackets and click, per minute (middle of 100 to 120)", "widget":"slider", "min":100, "max":120, "step":1}'
    - '// @input float roundLengthSec = 120 {"hint":"Round length from the first compression, seconds (switch compressors about every 2 min)", "widget":"slider", "min":10, "max":180, "step":5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
