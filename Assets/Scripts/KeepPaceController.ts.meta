    - '// @ui {"widget":"group_start", "label":"Coaching"}'
    - '// @input float fadeAfterOnPace = 10 {"hint":"Consecutive on-pace compressions before brackets and click fade", "widget":"slider", "min":3, "max":30, "step":1}'
    - '// @input float clickFadeBeats = 3 {"hint":"Beats over which the click lowers and stops once the brackets are gone", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float driftGapSec = 1 {"hint":"No compression for longer than this counts as drift, seconds", "widget":"slider", "min":0.6, "max":3, "step":0.1}'
    - '// @input float earlyEndIdleSec = 3 {"hint":"No compression for this long ends the round early, seconds", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @input float correctionMinGapSec = 5 {"hint":"Minimum time between two spoken corrections, seconds", "widget":"slider", "min":1, "max":15, "step":0.5}'
    - '// @input float correctionReliableCount = 4 {"hint":"Compressions needed in the last 3 s before a correction is spoken (reliable cadence)", "widget":"slider", "min":2, "max":8, "step":1}'
    - '// @input float targetHitRadiusCm = 5 {"hint":"Pinches closer than this to the target center count as on the target, cm", "widget":"slider", "min":2, "max":10, "step":0.5}'
