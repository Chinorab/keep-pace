  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">KeepPaceController: CPR rhythm coach (training only)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
