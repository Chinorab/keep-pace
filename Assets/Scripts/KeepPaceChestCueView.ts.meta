  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">KeepPaceChestCueView: target marker and rhythm brackets</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject chestTarget {"hint":"ChestTarget root: moved to the placed target position (marker, brackets, audio follow it)"}'
    - '// @input SceneObject targetRing {"hint":"Ring of the target marker (RenderMeshVisual)"}'
    - '// @input SceneObject targetDot {"hint":"Center dot of the target marker (RenderMeshVisual)"}'
    - '// @input SceneObject placementPreview {"hint":"Ghost ring shown under the pointer where a pinch would place the target"}'
