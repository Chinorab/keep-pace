    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Brackets</span>"}'
    - '// @ui {"widget":"group_start", "label":"Brackets"}'
    - '// @input float bracketLengthCm = 12 {"hint":"Bracket length along the chest depth, cm (brief: about 12)", "widget":"slider", "min":4, "max":20, "step":0.5}'
    - '// @input float bracketStrokeCm = 1 {"hint":"Bracket stroke, cm (brief: 1)", "widget":"slider", "min":0.3, "max":3, "step":0.1}'
    - '// @input float pushOffsetCm = 7 {"hint":"Distance from target center on push, cm (brief: about 7, keeps 2 cm from 10 cm wide hands)", "widget":"slider", "min":5, "max":15, "step":0.5}'
    - '// @input float releaseOffsetCm = 9 {"hint":"Distance from target center on release, cm (brief: about 9)", "widget":"slider", "min":5, "max":15, "step":0.5}'
    - '// @input float thickenFactor = 2.2 {"hint":"Stroke multiplier while a correction is given (shape change, not color only)", "widget":"slider", "min":1, "max":4, "step":0.1}'
    - '// @input float endPulseOffsetCm = 14 {"hint":"Distance reached by the slow end pulse, cm", "widget":"slider", "min":9, "max":25, "step":0.5}'
    - '// @input float bracketMaxOpacity = 0.6 {"hint":"Bracket opacity at full guidance (thin and low opacity)", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
    - '// @input vec3 cueColor = "{1,1,1}" {"hint":"Bracket and marker color. Keep it light: the display is additive", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
